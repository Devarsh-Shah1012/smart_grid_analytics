# ============================================================
#  config/cluster.env
#  Central configuration for all cluster hosts and ports.
#  Edit these values to match your actual VM/cloud IPs.
# ============================================================

# ── Cluster A — Streaming Layer ──────────────────────────────
CLUSTER_A_MASTER=192.168.1.10
CLUSTER_A_WORKER1=192.168.1.11
CLUSTER_A_WORKER2=192.168.1.12

# ── Cluster B — Storage Layer ────────────────────────────────
CLUSTER_B_MASTER=192.168.1.20
CLUSTER_B_WORKER1=192.168.1.21
CLUSTER_B_WORKER2=192.168.1.22

# ── Cluster C — Analytics Layer ──────────────────────────────
CLUSTER_C_MASTER=192.168.1.30
CLUSTER_C_WORKER1=192.168.1.31
CLUSTER_C_WORKER2=192.168.1.32

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BROKER=${CLUSTER_A_MASTER}:9092
ZOOKEEPER_HOST=${CLUSTER_A_MASTER}:2181
KAFKA_TOPIC_METERS=meter-readings
KAFKA_TOPIC_ALERTS=anomaly-alerts

# ── HDFS ─────────────────────────────────────────────────────
HDFS_NAMENODE=hdfs://${CLUSTER_B_MASTER}:9000
HDFS_RAW_PATH=/smart_grid/raw/meter_readings
HDFS_CLEAN_PATH=/smart_grid/clean/meter_readings
HDFS_MODELS_PATH=/smart_grid/models
HDFS_FORECASTS_PATH=/smart_grid/forecasts
HDFS_REPORTS_PATH=/smart_grid/reports

# ── HBase ────────────────────────────────────────────────────
HBASE_MASTER=${CLUSTER_B_MASTER}
HBASE_ZOOKEEPER=${CLUSTER_B_MASTER}:2181
HBASE_TABLE_READINGS=meter_readings
HBASE_TABLE_ALERTS=anomaly_alerts

# ── Hive ─────────────────────────────────────────────────────
HIVE_METASTORE=thrift://${CLUSTER_C_MASTER}:9083
HIVE_DATABASE=smart_grid

# ── Spark ────────────────────────────────────────────────────
SPARK_MASTER_A=spark://${CLUSTER_A_MASTER}:7077
SPARK_MASTER_C=spark://${CLUSTER_C_MASTER}:7077
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MEMORY=2g

# ── Superset ─────────────────────────────────────────────────
SUPERSET_HOST=${CLUSTER_C_MASTER}
SUPERSET_PORT=8088

# ── Streaming Parameters ─────────────────────────────────────
STREAM_TRIGGER_SECONDS=30
ANOMALY_ZSCORE_THRESHOLD=3.0
ROLLING_WINDOW_DAYS=7
SUSTAINED_ANOMALY_COUNT=5

# ── Dataset Paths (local, before HDFS upload) ────────────────
LOCAL_DATA_DIR=/opt/smart_grid_data
LONDON_DATA_DIR=${LOCAL_DATA_DIR}/london
PJM_DATA_DIR=${LOCAL_DATA_DIR}/pjm
UCI_DATA_DIR=${LOCAL_DATA_DIR}/uci

# ── Replay Speed ─────────────────────────────────────────────
# 1 simulated day compressed into N real seconds
KAFKA_REPLAY_SPEED_SECONDS=10
